total_distance = sum(
distance_km,
na.rm = TRUE
),
.groups = "drop"
) %>%
arrange(desc(total_distance)) %>%
slice(1)
print(top_distance_driver)
# 13. DETECT RIDES WHERE PASSENGER RATING < 3
low_rated_rides <- rides_df %>%
filter(
ride_rating < 3
) %>%
select(
ride_id,
passenger_id,
driver_id,
name,
ride_rating
)
print(low_rated_rides)
# 14. TIME SERIES PLOT - TOTAL NUMBER OF RIDES PER DAY OVER LAST MONTH
daily_rides <- rides_df %>%
mutate(
date = as.Date(start_time)
) %>%
filter(
date >= max(date, na.rm = TRUE) - 30,
date <= max(date, na.rm = TRUE)
) %>%
count(date)
print(daily_rides)
ggplot(
daily_rides,
aes(
x = date,
y = n
)
) +
geom_line() +
geom_point() +
labs(
title = "Total Number of Rides per Day - Last Month",
x = "Date",
y = "Number of Rides"
) +
theme_minimal()
# 15. FUNCTION TO GET DRIVER DETAILS
get_driver_details <- function(driver_id_input) {
driver_rides <- rides_df %>%
filter(
driver_id == driver_id_input
)
if (nrow(driver_rides) == 0) {
return("Driver not found")
}
total_earnings <- sum(
driver_rides$fare,
na.rm = TRUE
)
average_rating <- mean(
driver_rides$ride_rating,
na.rm = TRUE
)
return(
list(
rides = driver_rides,
total_earnings = total_earnings,
average_rating = average_rating
)
)
}
result <- get_driver_details("D001")
print(result$rides)
print(result$total_earnings)
print(result$average_rating)
